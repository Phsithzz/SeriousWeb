NODE_ENV=development
PORT=3000

# Use DATABASE_URL on managed PostgreSQL, or the individual DB_* values locally.
DATABASE_URL=
DBHOST=127.0.0.1
DBPORT=5432
DBUSER=postgres
DBPWD=change-me
DB=adidus
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=replace-with-at-least-32-random-characters

# Comma-separated, exact frontend origins. Do not use * with credentials.
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
ENABLE_API_DOCS=true
